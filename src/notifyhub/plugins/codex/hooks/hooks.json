{
  "description": "NotifyHub notifications + agent status: turn completion, errors, permission prompts, questions, live session state",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/notifyhub-codex.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\notifyhub-codex.py\"",
            "async": false,
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/notifyhub-codex.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\notifyhub-codex.py\"",
            "async": false,
            "timeout": 3
          }
        ]
      }
    ],
    "PostModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/notifyhub-codex.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\notifyhub-codex.py\"",
            "async": false,
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/notifyhub-codex.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\notifyhub-codex.py\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/notifyhub-codex.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\notifyhub-codex.py\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${NOTIFYHUB_CLI_HOST-127.0.0.1}\"; p=\"${NOTIFYHUB_CLI_PORT-9080}\"; s=\"${NOTIFYHUB_CLI_SCHEME-http}\"; [ -n \"$h\" ] && [ -n \"$p\" ] && curl -fsS -m 2 -X POST -H \"content-type: application/json\" -H \"x-notifyhub-host: $(hostname)\" --data-binary @- \"$s://$h:$p/api/status/codex/running\" >/dev/null 2>&1; exit 0'",
            "commandWindows": "cmd /c curl -fsS -m 2 -X POST -H \"content-type: application/json\" -H \"x-notifyhub-host: %COMPUTERNAME%\" --data-binary @- \"%NOTIFYHUB_CLI_SCHEME%://%NOTIFYHUB_CLI_HOST%:%NOTIFYHUB_CLI_PORT%/api/status/codex/running\" >nul 2>&1",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ]
  }
}
